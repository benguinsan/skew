# Clerk (client + server)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oxylabs Web Scraper API (server only)
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# Shared admin secret for action routes — send as x-biasly-admin-secret (server only)
BIASLY_ADMIN_SECRET=

# AI analysis via OpenRouter (server only)
OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# ANALYSIS_BATCH_SIZE=

# Previously: OpenAI API direct (server only)
# OPENAI_API_KEY=

# CRON_SECRET is injected by Vercel — do not add to .env.local
